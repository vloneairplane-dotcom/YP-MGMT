# ===== Ye Pesare MGMT Bot =====
# توکن ربات رو از @BotFather بگیر
BOT_TOKEN=123456:ABC-DEF...

# آیدی عددی ادمین اصلی (از @userinfobot بگیر)
ADMIN_IDS=111111111

# آیدی عددی گروه کاری (اختیاری - برای اعلان‌های گروه)
GROUP_CHAT_ID=

# پورت داشبورد شیشه‌ای
DASH_PORT=8000

# مسیر دیتابیس
DB_PATH=data/yp_mgmt.db

# ۱ = داده‌ی نمونه (پروژه/تسک دمو) موقع اولین اجرا ساخته بشه — پیش‌فرض خاموش،
# بورد از صفر خالی میاد و خودت می‌چینیش
DEMO_SEED=0

# پروکسی برای دسترسی به تلگرام (فقط اگر سرورت api.telegram.org رو باز نداره)
# مثال: socks5://user:pass@host:port  یا  http://host:port
TELEGRAM_PROXY=
