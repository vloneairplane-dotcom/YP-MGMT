# ===== Ye Pesare MGMT Bot =====
# توکن ربات رو از @BotFather بگیر
BOT_TOKEN=123456:ABC-DEF...

# آیدی عددی ادمین اصلی (از @userinfobot بگیر)
ADMIN_IDS=111111111

# 🔐 آیدی عددی گروه کاری — اگر مقدار بدهی، ربات ONLY در همین گروه چت می‌کنه
# (و در گروه‌های دیگه کاملاً ساکته). پیوی/دی‌ام هم برای همه قفله،
# فقط ادمین‌های ADMIN_ids میان‌بر ابزارهای مدیریتی دارن.
# پیدا کردن آیدی گروه: بات رو گروه Add کن، یه پیام بفرست، بعد لاگ‌های
# Render رو ببین: «🔒 blocked chat id=-100...» همون عددو کپی کن.
# (بدون مقدار = ربات در همه گروه‌ها آزاد و فقط پیوی قفله)
GROUP_CHAT_ID=

# پورت داشبورد شیشه‌ای
DASH_PORT=8000

# مسیر دیتابیس
DB_PATH=data/yp_mgmt.db

# ۱ = داده‌ی نمونه (پروژه/تسک دمو) موقع اولین اجرا ساخته بشه — پیش‌فرض خاموش،
# بورد از صفر خالی میاد و خودت می‌چینیش
DEMO_SEED=0

# پروکسی برای دسترسی به تلگرام (فقط اگر سرورت api.telegram.org رو باز نداره)
# مثال: socks5://user:pass@host:port  یا  http://host:port
TELEGRAM_PROXY=
